# Copy to .env for local development. On Vercel these live in Settings > Environment Variables.

# ---- database and media (Vercel > Storage adds DATABASE_URL and BLOB_READ_WRITE_TOKEN itself)
DATABASE_URL=postgres://postgres@localhost:5433/fds
BLOB_READ_WRITE_TOKEN=

# ---- dashboard
PAYLOAD_SECRET=                       # any long random string; signs the login cookies
NEXT_PUBLIC_SERVER_URL=http://localhost:3000   # production: https://www.footscraydentalstudio.com.au
PUBLISH_HOOK_URL=                     # Vercel deploy hook; the Publish button calls it
ADMIN_EMAIL=                          # first admin account, created on the first build
ADMIN_PASSWORD=
ADMIN_NAME=GYA

# ---- contact form (SMTP2GO)
SMTP2GO_API_KEY=
CONTACT_TO=info@footscraydentalstudio.com.au, brett@generateyouraudience.com, rowayne@gyaclients.com
CONTACT_FROM=Footscray Dental Studio <noreply@footscraydentalstudio.com.au>
CONTACT_AUTOREPLY=false
MAIL_PROVIDER=log                     # local only: emails are written to outbox/ instead of sent
